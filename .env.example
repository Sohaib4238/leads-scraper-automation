# -----------------------------------------------------------------------------
# Lead Scraper & Qualification Engine - Root Environment Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file to version control.

# =============================================================================
# 1. MySQL Database Configuration
# =============================================================================
# Hostname or IP address of your MySQL database server (e.g. localhost or 127.0.0.1)
DB_HOST=localhost

# Port number for MySQL service (default is 3306)
DB_PORT=3306

# MySQL database username (e.g. root or your custom DB user)
DB_USER=root

# MySQL user password (leave empty if no password is set)
DB_PASSWORD=your_mysql_password_here

# Target database name (create with: CREATE DATABASE lead_scraper CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;)
DB_NAME=lead_scraper

# Optional: Full connection URL override (if set, overrides DB_HOST/USER/PASSWORD/NAME above)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/lead_scraper?charset=utf8mb4

# =============================================================================
# 2. Map & Places Discovery API Keys
# =============================================================================
# Geoapify API Key: Sign up for free at https://www.geoapify.com/ (3,000 free requests/day)
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Google Places API Key (Optional fallback provider): Sign up on Google Cloud Console
GOOGLE_PLACES_API_KEY=
